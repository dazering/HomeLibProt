<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestInpLine.fs" />
    <Compile Include="TestBook.fs" />
    <Compile Include="TestBookImporter.fs" />
    <Compile Include="TestGenreListLine.fs" />
    <Compile Include="TestInpxImporter.fs" />
    <Compile Include="TestAuthorHierarchicalSearchImporter.fs" />
    <Compile Include="TestCollectionValidator.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeLibProt.CollectionImporter\HomeLibProt.CollectionImporter.fsproj" />
    <ProjectReference Include="..\HomeLibProt.Common.Tests\HomeLibProt.Common.Tests.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestCases\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
